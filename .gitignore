# cloud-ingest/ = clona MAVIS-CLOUD: sursa contractului consumatorului SI copia de lucru
# a livrarii cozii secundare (contractul spune "Local scrie sarcina aici").
# NU se comite: ar duplica date personale (CV-uri, telefon, clienți) într-un repo nou,
# și ar îngropa un repo în altul. Se accesează prin cale.
cloud-ingest/

# Fișiere de stare — se rescriu la fiecare măsurătoare
push-pending.json
live-state.json
*.log

# OS
Thumbs.db
desktop.ini
.DS_Store

logs/

# --- Platforma Jules (_JULES-Optimus_CI) -------------------------------
# Descărcările de repo-uri făcute de Popy NU se comite. Conțin date
# personale (CV-uri, telefon, nume de clienți) iar MAVIS-OPTIMUS-CI este
# PUBLIC. Copia veche din commit-uri a fost eliminată prin "git mv catre
# arhivă"; istoricul public mai conține acele fișiere — asta e o decizie
# a lui Popy, nu una a mea.
_JULES-Optimus_CI/_GitHub-Main_Repos-Local/

# Clonele de lucru, folosite doar pentru verificarea locală a PR-urilor
_JULES-Optimus_CI/work/

# Jurnalele rulării zilnice
_JULES-Optimus_CI/logs/

# Artefacte temporare și drafturi
_JULES-Optimus_CI/state/tmp/
_JULES-Optimus_CI/state/draft-*.md
_JULES-Optimus_CI/state/verify/

# --- Stare si probe locale (2026-10-27) ---------------------------------
# state/ = rezultate de masuratoare, probe temporare, loguri de diagnostic.
# Nu se comite: sunt masuratori punctuale, nu continut de proiect.
state/

# Cache-ul byte-code al lui Python. Nu e continut de proiect: se regenereaza
# la prima rulare. Masurat 2026-10-27 - un .pyc a ajuns in index la comit.
__pycache__/
*.pyc
